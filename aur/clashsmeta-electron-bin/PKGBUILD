pkgname=clashsmeta-electron-bin
_pkgname=clashsmeta
pkgver=1.26.7
pkgrel=1
pkgdesc="Another Mihomo GUI"
arch=('x86_64' 'aarch64')
url="https://github.com/assassin321/ClashSMeta"
license=('GPL-3.0-only')
provides=("$_pkgname=$pkgver")
conflicts=("$_pkgname" "$_pkgname-git" "$_pkgname-bin" "$_pkgname-rolling-bin" "$_pkgname-electron" "$_pkgname-electron-git")
depends=('electron' 'alsa-lib' 'gtk3' 'libnotify' 'nss' 'libxss' 'libxtst' 'xdg-utils' 'at-spi2-core' 'util-linux-libs' 'libsecret')
optdepends=('libappindicator-gtk3: Allow clashsmeta to extend a menu via Ayatana indicators in Unity, KDE or Systray (GTK+ 3 library).')
makedepends=('asar' 'libarchive')
install=$_pkgname.install
source=("${_pkgname}.desktop" "${_pkgname}.sh")
source_x86_64=("${_pkgname}-${pkgver}-x86_64.deb::${url}/releases/download/${pkgver}/clashsmeta-linux-${pkgver}-amd64.deb")
source_aarch64=("${_pkgname}-${pkgver}-aarch64.deb::${url}/releases/download/${pkgver}/clashsmeta-linux-${pkgver}-arm64.deb")
sha256sums=(
    "9163b61e496487c06afa67318710c49fb755bded663520edbb89a934a8b25ee0"
    "ce855656fb0682d403685244c77dd2d90ec6efb207753fb7a6ddc1e9b6aa2c49"
)
sha256sums_x86_64=('0e3c8c91b206bbdfa517d57b8646184301214220d50e3b020f96d2fec593e6c2')
sha256sums_aarch64=('fb85ecd9e827eab14b97413f0d356250296d3746e593d9af334edf0d737f012a')
options=('!debug' '!lto')

package() {
    bsdtar -xf data.tar.xz -C $srcdir
    asar extract $srcdir/opt/clashsmeta/resources/app.asar ${pkgdir}/opt/clashsmeta
    cp -r $srcdir/opt/clashsmeta/resources/sidecar ${pkgdir}/opt/clashsmeta/resources/
    cp -r $srcdir/opt/clashsmeta/resources/files ${pkgdir}/opt/clashsmeta/resources/
    chmod +x ${pkgdir}/opt/clashsmeta/resources/files/sparkle-service
    chmod +sx ${pkgdir}/opt/clashsmeta/resources/sidecar/mihomo
    chmod +sx ${pkgdir}/opt/clashsmeta/resources/sidecar/mihomo-alpha
    install -Dm755 "${srcdir}/${_pkgname}.sh" "${pkgdir}/usr/bin/${_pkgname}"
    install -Dm644 "${_pkgname}.desktop" "${pkgdir}/usr/share/applications/${_pkgname}.desktop"
    install -Dm644 "${pkgdir}/opt/clashsmeta/resources/icon.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/${_pkgname}.png"

    chown -R root:root ${pkgdir}
}
