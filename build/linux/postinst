#!/bin/bash

if [ ! -f '/usr/bin/clashsmeta' ] || [ -L '/usr/bin/clashsmeta' ]; then
    if type update-alternatives 2>/dev/null >&1; then
        # Remove previous link if it doesn't use update-alternatives
        if [ -L '/usr/bin/clashsmeta' -a -e '/usr/bin/clashsmeta' -a "`readlink '/usr/bin/clashsmeta'`" != '/etc/alternatives/clashsmeta' ]; then
            rm -f '/usr/bin/clashsmeta'
        fi
        update-alternatives --install '/usr/bin/clashsmeta' 'clashsmeta' '/opt/clashsmeta/clashsmeta' 100 || ln -sf '/opt/clashsmeta/clashsmeta' '/usr/bin/clashsmeta'
    else
        ln -sf '/opt/clashsmeta/clashsmeta' '/usr/bin/clashsmeta'
    fi
fi

sed -i 's/Name=clashsmeta/Name=ClashSMeta/' '/usr/share/applications/clashsmeta.desktop'

chmod 4755 '/opt/clashsmeta/chrome-sandbox' || true
chmod +sx /opt/clashsmeta/resources/sidecar/mihomo
chmod +sx /opt/clashsmeta/resources/sidecar/mihomo-alpha

if [ -d '/opt/clashsmeta/resources/files/sub-store-frontend' ]; then
    chmod -R go-w '/opt/clashsmeta/resources/files/sub-store-frontend' 2>/dev/null || true
fi

restore_clashsmeta_service_if_was_running() {
    SERVICE_NAME='ClashSMetaService'
    STATE_FILE='/run/clashsmeta/service-was-running'

    if [ ! -f "$STATE_FILE" ]; then
        return
    fi
    rm -f "$STATE_FILE" 2>/dev/null || true

    if command -v systemctl >/dev/null 2>&1; then
        systemctl start "$SERVICE_NAME" >/dev/null 2>&1 || true
    elif command -v service >/dev/null 2>&1; then
        service "$SERVICE_NAME" start >/dev/null 2>&1 || true
    elif [ -x "/etc/init.d/$SERVICE_NAME" ]; then
        "/etc/init.d/$SERVICE_NAME" start >/dev/null 2>&1 || true
    fi
}

restore_clashsmeta_service_if_was_running

if hash update-mime-database 2>/dev/null; then
    update-mime-database /usr/share/mime || true
fi

if hash update-desktop-database 2>/dev/null; then
    update-desktop-database /usr/share/applications || true
fi
